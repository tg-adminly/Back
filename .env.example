# @BotFather dan olingan token
BOT_TOKEN=
# Telegram ID'lar, vergul bilan (@userinfobot ko'rsatadi)
OWNER_IDS=
EDITOR_IDS=
# Bizning kanal/guruh ID'si (-100... ko'rinishida). Bot u yerda admin bo'lishi shart.
MAIN_CHAT_ID=
# Shaxsiy ma'lumotlarni shifrlash kaliti. Yaratish:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DIQQAT: bu kalit yo'qolsa, shifrlangan ma'lumotlarni ochib bo'lmaydi.
FERNET_KEY=
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
TIMEZONE=Asia/Tashkent

# Veb-panel (CRM). Domen ulangach: PANEL_URL=https://panel.domen.uz
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
PANEL_URL=http://localhost:8080

# 2-bosqich (kontent)
OPENAI_API_KEY=
# 3-bosqich (userbot, my.telegram.org — qoralama akkaunt bilan)
TG_API_ID=
TG_API_HASH=
